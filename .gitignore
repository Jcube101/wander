# --- Never commit media or location data (privacy by design) ---
# Bracketed patterns so upper-case names (IMG_0001.JPG, clip.MOV) are ignored on
# case-sensitive file systems too.
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[wW][eE][bB][pP]
*.[dD][nN][gG]
*.[aA][rR][wW]
*.[cC][rR][23]
*.[nN][eE][fF]
*.[mM][pP]4
*.[mM][oO][vV]
*.[mM]4[vV]
*.[lL][rR][fF]
*.[gG][pP][xX]
*.[kK][mM][lLzZ]
_tripmap/
overrides*.json
clip_locations.csv
*_meta.csv
exif_samples.txt
trip.json
trip.js
trips.json
build_args.json
build_errors.txt
# The one exception: the README screenshot of the reference viewer's landing page
# (public covers and lock badges only; no trip contents).
!/docs/viewer-landing.png

# --- Your instance's settings (the *.example.* files are committed) ---
wander.config.json
worker/wrangler.toml
site/public/config.local.js
CLAUDE.local.md

# --- Secrets ---
.env
.env.*
*.env
.wander/
*.pem
.dev.vars
rclone.conf

# --- Tooling ---
__pycache__/
*.pyc
.venv/
node_modules/
.wrangler/
.playwright-mcp/
.DS_Store
Thumbs.db
